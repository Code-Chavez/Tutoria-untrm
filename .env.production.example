# Configuración de PRODUCCIÓN. Copie a .env.production, complete TODO y no lo suba al repositorio.

# Dominio público (DNS apuntando a este servidor). Caddy obtiene el certificado HTTPS solo.
DOMAIN=sit.ejemplo.edu.pe
# Si otro componente termina el HTTPS (balanceador, proxy institucional), use SITE_ADDRESS=:80
# SITE_ADDRESS=:80

# Base de datos (solo accesible dentro de la red de contenedores)
POSTGRES_USER=sit_user
POSTGRES_PASSWORD=
POSTGRES_DB=sit_db

# Secreto de los tokens: aleatorio y largo, p. ej.  openssl rand -hex 48
JWT_SECRET=

# Primer administrador (solo se usa en una instalación nueva; luego puede quitarse)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo saliente (recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Cifrado del correo: true = STARTTLS obligatorio (recomendado); false solo en un relay interno aprobado por TI.
# Con puerto 465 use SMTP_SECURE=true. Sin definir una de las dos opciones el servidor no arranca en producción.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SIT UNTRM <no-reply@untrm.edu.pe>"
# Vigencia (horas) del enlace de invitación de una cuenta nueva; sirve una sola vez.
INVITATION_TTL_HOURS=72
# Certificación del docente tutor: sin plantilla oficial solo existen certificados de DEMOSTRACIÓN (marca de agua, numeración DEMO-,
# sin firma ni entrega). En producción está desactivado salvo que se active aquí de forma explícita; hacerlo es una decisión de la DBU.
CERTIFICATE_DEMO_MODE=false
# Avisos por correo (solicitudes, derivaciones, cambios de estado) al correo institucional; usa el mismo SMTP. `false` los desactiva.
EMAIL_NOTIFICATIONS=true

# Copia de respaldo fuera del servidor (al menos una; ver backup/README.md)
BACKUP_OFFSITE_DIR=
BACKUP_UPLOAD_CMD=
