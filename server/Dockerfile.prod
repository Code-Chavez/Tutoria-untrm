# Imagen de PRODUCCIÓN del servidor: compilada, sin código fuente, sin seed de demostración y sin modo dev.
FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY prisma ./prisma
RUN pnpm prisma generate
COPY tsconfig.json ./
COPY src ./src
RUN pnpm run build

FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
ENV NODE_ENV=production
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
# Solo dependencias de producción (prisma está entre ellas: aplica las migraciones al arrancar).
RUN pnpm install --frozen-lockfile --prod
COPY prisma ./prisma
RUN pnpm prisma generate
COPY --from=build /app/dist ./dist
# Los adjuntos viven en un volumen; el proceso no corre como root.
RUN mkdir -p /app/storage && chown node:node /app/storage
USER node
EXPOSE 3000
# (Sin pnpm en tiempo de ejecución: el usuario no root no tiene corepack preparado.)
# Valida la configuración (si es insegura, termina sin tocar la base), migra, asegura los datos base y el primer administrador (ADMIN_EMAIL/ADMIN_PASSWORD, solo en una instalación
# nueva) y arranca. Nunca ejecuta el seed de demostración.
CMD ["sh", "-c", "node dist/infrastructure/config/checkProductionConfig.js && node node_modules/prisma/build/index.js migrate deploy && node dist/infrastructure/bootstrap/bootstrap.js && node dist/index.js"]
