NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://sit_user:sit_pass@localhost:5432/sit_db

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173

# Correo saliente (recuperación de contraseña, A09). Sin SMTP_HOST el envío falla de forma
# explícita y en producción el servidor no arranca. En desarrollo, docker compose levanta Mailpit
# (bandeja en http://localhost:8025) y configura estos valores solo.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
# true solo con TLS implícito (puerto 465); con 587 se negocia STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SIT UNTRM <no-reply@untrm.edu.pe>"
PASSWORD_RESET_TTL_MINUTES=60
